# Animal World API — variáveis de ambiente
# Copie para .env (ou exporte no shell) e ajuste por ambiente.

# Porta da API (default 3100)
PORT=3100

# Segredo dos tokens de sessão HMAC.
# OBRIGATÓRIO em produção: sem ele a API gera server/.session-secret aleatório,
# o que derruba todas as sessões a cada reinstalação/clone.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Origens liberadas no CORS, separadas por vírgula.
# Default: http://localhost:4200 (ng serve do Angular)
ALLOWED_ORIGINS=http://localhost:4200

# Banco Postgres (default aponta pro docker-compose local na porta 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=animalworld
DB_PASSWORD=animalworld
DB_NAME=animalworld
