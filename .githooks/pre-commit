#!/bin/sh
# Pre-commit hook: Bloqueia commits diretos na branch 'main' e 'master'

branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || echo '')"

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "❌ [BLOQUEIO DE SEGURANÇA - POLÍTICA DE BRANCHES]"
  echo "------------------------------------------------------------------------"
  echo "ERRO: Commits diretos na branch '$branch' estão estritamente PROIBIDOS!"
  echo ""
  echo "Padrão Obrigatório: Toda nova feature ou ajuste DEVE partir da main:"
  echo "   1. git checkout main"
  echo "   2. git pull origin main"
  echo "   3. git checkout -b feat/nome-da-feature   (ou fix/nome-do-ajuste)"
  echo "   4. Desenvolva e comite: git commit -m \"tipo(escopo): descrição\""
  echo "   5. Envie a branch: git push -u origin feat/nome-da-feature"
  echo "   6. Abra um Pull Request no GitHub apontando para a 'main'."
  echo "------------------------------------------------------------------------"
  echo ""
  exit 1
fi

exit 0
